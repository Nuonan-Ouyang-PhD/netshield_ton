/.gitattributes text eol=lf
/.gitignore text eol=lf
/*.md text eol=lf
/CITATION.cff text eol=lf
/.github/** text eol=lf
/formal_rc1/** text eol=lf
/ToN_V1_3_Methodology_Repair_20260909/** text eol=lf
/scripts/** text eol=lf

*.pdf binary
*.png binary
*.zip binary

# These frozen unified diffs encode an empty context line as one ASCII space.
# Preserve their exact bytes and all whitespace checks other than blank-at-eol.
/supporting_material/experiment_extension/hardware/instrumented_allocator.patch whitespace=-blank-at-eol
/supporting_material/experiment_extension/stage_adapter/physical_capture_hooks.patch whitespace=-blank-at-eol

# CSV evidence preserves the CRLF bytes hashed by the acquisition tools.
/supporting_material/experiment_extension/content_measurement/**/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
/supporting_material/experiment_extension/content_measurement/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
